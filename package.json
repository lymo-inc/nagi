{
  "name": "nagi-js",
  "private": true,
  "description": "A lightweight, type-safe declarative workflow library for TypeScript.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:integration": "NAGI_POSTGRES_TEST_URL=postgres://postgres:postgres@localhost:5433/nagi_test pnpm -F @nagi-js/postgres test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.test.yml down -v",
    "verify": "pnpm lint && pnpm -r build && pnpm verify:publint && pnpm verify:types",
    "verify:publint": "pnpm -r --parallel exec publint",
    "verify:types": "tsc -p test-types/tsconfig.json",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm verify && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@changesets/cli": "^2.31.0",
    "@nagi-js/core": "workspace:*",
    "@nagi-js/otel": "workspace:*",
    "@nagi-js/pgmq": "workspace:*",
    "@nagi-js/postgres": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "publint": "^0.2.12",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  }
}
